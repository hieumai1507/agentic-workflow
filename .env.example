# ==============================================================================
# Agentic PII Masking Workflow - Environment Configuration Template
# ==============================================================================

# Application Environment
APP_NAME="Agentic PII Masking Workflow"
ENVIRONMENT=production
LOG_LEVEL=INFO

# Redis Streams & Async Message Broker
REDIS_URL=redis://localhost:6379/0
STREAM_NAME=email_ingestion_stream
GROUP_NAME=agentic_masking_workers
DLQ_STREAM_NAME=email_dlq_stream
WORKER_ID=worker_prod_1
MAX_CONCURRENT_TASKS=16
IDLE_TIME_FOR_AUTOCLAIM_MS=90000

# LLM Gateway & API Keys (Optional: Leave empty for offline deterministic / heuristic mode)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PRIMARY_MODEL=gpt-4o-mini
LLM_FALLBACK_MODEL=claude-3-5-sonnet-20241022
LLM_TEMPERATURE=0.0
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=15.0
CIRCUIT_BREAKER_FAIL_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY_SECONDS=60

# Cascade Routing / Fast-Path Optimization (Token Cost & Latency Saver)
ENABLE_CASCADE_ROUTING=true

# Enterprise Cloud Key Management Service (KMS) & Envelope Encryption (NIST SP 800-57)
# Options: "aws_kms", "hashicorp_vault", "local_envelope"
KMS_PROVIDER=local_envelope
AWS_KMS_KEY_ARN=arn:aws:kms:us-east-1:123456789012:key/mrk-pii-vault-master-kek
AWS_REGION=us-east-1
HASHICORP_VAULT_ADDR=http://127.0.0.1:8200
HASHICORP_VAULT_TOKEN=
HASHICORP_TRANSIT_KEY=pii-vault-transit-kek
VAULT_MASTER_KEY=dGhpcy1pcy1hLXNlY3VyZS0zMi1ieXRlLXZhdWx0LWtleSE=
VAULT_STORAGE_TTL_SECONDS=2592000

# Human-in-the-Loop (HITL) Governance Gate
ENABLE_HITL_FOR_SECURITY_INCIDENTS=true
HITL_CONFIDENCE_THRESHOLD=0.90

# Downstream Target API (Mock Jira / Zendesk)
DOWNSTREAM_API_BASE_URL=http://localhost:8001
DOWNSTREAM_API_TOKEN=mock_jira_token_secure_9921
DOWNSTREAM_TIMEOUT=10.0

# TypeSafe AI (Jev System One) Automated Evaluation Pipeline
TYPESAFE_API_KEY=
TYPESAFE_ENDPOINT=https://api.typesafe.ai/v1/systemone
TYPESAFE_MODEL=jev-1.13
JEV_CONFIDENCE_THRESHOLD=0.90
